# run at build time (cmake -P) by the NeutrinoVersion target in src/CMakeLists.txt:
# writes OUT with the current git sha, only when it changed (a commit recompiles only nVersion.cc)
# needs GIT_EXECUTABLE, SOURCE_DIR and OUT
execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse HEAD
    WORKING_DIRECTORY ${SOURCE_DIR}
    OUTPUT_VARIABLE VERSION_GIT_SHA
    OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE GIT_RESULT
    ERROR_QUIET)
if (NOT GIT_RESULT EQUAL 0 OR VERSION_GIT_SHA STREQUAL "")
    set(VERSION_GIT_SHA "unknown")
endif()

set(CONTENT "// generated by resources/cmake/GitVersion.cmake at build time: do not edit\n#include \"nVersion.h\"\nconst char neutrinoGitSha[] = \"${VERSION_GIT_SHA}\";\n")

set(OLD_CONTENT "")
if (EXISTS ${OUT})
    file(READ ${OUT} OLD_CONTENT)
endif()
if (NOT OLD_CONTENT STREQUAL CONTENT)
    file(WRITE ${OUT} "${CONTENT}")
    message(STATUS "git sha ${VERSION_GIT_SHA}")
endif()
