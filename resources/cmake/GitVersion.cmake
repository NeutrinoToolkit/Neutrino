# run at build time (cmake -P) by the NeutrinoVersion target in src/CMakeLists.txt:
# writes OUT with the current git sha and version, only when they changed (a commit recompiles only nVersion.cc)
# needs GIT_EXECUTABLE, SOURCE_DIR and OUT
execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse HEAD
    WORKING_DIRECTORY ${SOURCE_DIR}
    OUTPUT_VARIABLE VERSION_GIT_SHA
    OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE GIT_RESULT
    ERROR_QUIET)
if (NOT GIT_RESULT EQUAL 0 OR VERSION_GIT_SHA STREQUAL "")
    set(VERSION_GIT_SHA "unknown")
endif()

# the version, as the wheel one (python/ci/version.py): major.minor of pyproject.toml, then the number of commits
# since the commit that changed its version line
set(NEUTRINO_VERSION "unknown")
if (EXISTS ${SOURCE_DIR}/pyproject.toml)
    file(STRINGS ${SOURCE_DIR}/pyproject.toml VERSION_LINE REGEX "^version = \"[0-9]+\\.[0-9]+")
    if (VERSION_LINE MATCHES "^version = \"([0-9]+)\\.([0-9]+)(\\.([0-9]+))?\"")
        set(NEUTRINO_VERSION "${CMAKE_MATCH_1}.${CMAKE_MATCH_2}")
        set(VERSION_PATCH "${CMAKE_MATCH_4}") # already there in the CI (version.py --write)
        execute_process(COMMAND ${GIT_EXECUTABLE} log -n1 --format=%H -G "^version = \"" -- pyproject.toml
            WORKING_DIRECTORY ${SOURCE_DIR}
            OUTPUT_VARIABLE VERSION_BASE
            OUTPUT_STRIP_TRAILING_WHITESPACE
            RESULT_VARIABLE GIT_RESULT
            ERROR_QUIET)
        if (GIT_RESULT EQUAL 0 AND NOT VERSION_BASE STREQUAL "")
            execute_process(COMMAND ${GIT_EXECUTABLE} rev-list --count ${VERSION_BASE}..HEAD
                WORKING_DIRECTORY ${SOURCE_DIR}
                OUTPUT_VARIABLE VERSION_PATCH
                OUTPUT_STRIP_TRAILING_WHITESPACE
                ERROR_QUIET)
        endif()
        if (NOT VERSION_PATCH STREQUAL "")
            set(NEUTRINO_VERSION "${NEUTRINO_VERSION}.${VERSION_PATCH}")
        endif()
    endif()
endif()

set(CONTENT "// generated by resources/cmake/GitVersion.cmake at build time: do not edit\n#include \"nVersion.h\"\nconst char neutrinoGitSha[] = \"${VERSION_GIT_SHA}\";\nconst char neutrinoVersion[] = \"${NEUTRINO_VERSION}\";\n")

set(OLD_CONTENT "")
if (EXISTS ${OUT})
    file(READ ${OUT} OLD_CONTENT)
endif()
if (NOT OLD_CONTENT STREQUAL CONTENT)
    file(WRITE ${OUT} "${CONTENT}")
    message(STATUS "version ${NEUTRINO_VERSION}, git sha ${VERSION_GIT_SHA}")
endif()
